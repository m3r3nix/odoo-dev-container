{
    "name": "Odoo Dev Container",
    "dockerComposeFile": "docker-compose.yml",
    "service": "workspace",
    "workspaceFolder": "/home/${localEnv:USER}/workspaces/repo/custom",
    "remoteUser": "odoo",
    "shutdownAction": "stopCompose",
    "remoteEnv": {
        "CODEX_HOME": "/home/${localEnv:USER}/.codex"
    },
    "forwardPorts": [443, 8069, 8072],
    "portsAttributes": {
        "443": {
        "label": "Odoo HTTPS",
        "protocol": "https"
        },
        "8069": {
        "label": "Odoo HTTP",
        "protocol": "http"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.cwd": "/home/${localEnv:USER}/workspaces/odoo_source",
                "terminal.integrated.defaultProfile.linux": "bash",
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python-envs.defaultEnvManager": "ms-python.python:system",
                "python.analysis.extraPaths": [
                    "/home/${localEnv:USER}/workspaces/odoo_source/odoo",
                    "/home/${localEnv:USER}/workspaces/odoo_source/enterprise"
                ],
                "files.watcherExclude": {
                    "**/home/${localEnv:USER}/workspaces/odoo_source/odoo/**": true,
                    "**/home/${localEnv:USER}/workspaces/odoo_source/enterprise/**": true
                }
            },
            "extensions": [
                "DavidAnson.vscode-markdownlint",
                "DotJoshJohnson.xml",
                "github.copilot-chat",
                "ms-azuretools.vscode-docker",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "openai.chatgpt"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "moby": false
        },
        "ghcr.io/devcontainers/features/github-cli:1": {}
    }
}
